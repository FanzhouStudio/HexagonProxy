extends SceneTree

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	var config := ConfigFile.new()
	config.set_value("ui", "theme", "blue_healing")
	config.save("user://ui_theme.cfg")
	var service = load("res://scripts/modules/ui/ui_theme_service.gd").new()
	root.add_child(service)
	service.initialize()
	assert(service.current_theme_id() == "qq_warm", "Existing users get the redesigned default once")
	var ui = load("res://scripts/ui/ui_factory.gd").new(service.snapshot())
	var panel: PanelContainer = ui.panel(ui.surface_color, ui.border_color, 20)
	var box = panel.get_theme_stylebox("panel")
	assert(box is StyleBoxFlat and box.shadow_size == 0 and box.corner_radius_top_left <= 7)
	var button: Button = ui.small_choice_button("添加账号")
	ui.primary_button(button)
	ui.apply_theme(service.snapshot())
	assert(button.get_theme_stylebox("normal").bg_color == ui.green_color)
	assert(button.get_theme_color("font_color") == ui.color("primary_text"))
	var label: Label = ui.label("正文", 11, ui.text_color)
	assert(label.get_theme_font_size("font_size") >= 15)
	assert(ui.text_color.get_luminance() > ui.surface_color.get_luminance() * 3)
	service.set_theme("midnight")
	var second = load("res://scripts/modules/ui/ui_theme_service.gd").new()
	root.add_child(second)
	second.initialize()
	assert(second.current_theme_id() == "midnight", "Migration must not override later explicit theme choices")
	panel.free()
	button.free()
	label.free()
	print("PASS: flat styles, primary button retheming, readable typography and one-time theme migration")
	quit(0)
